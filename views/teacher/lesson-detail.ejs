<%- include('../partials/head') %>
<% if (busy) { %><meta http-equiv="refresh" content="5"><% } %>
<%- include('../partials/nav') %>
<main class="wrap page">
  <div class="page-head">
    <div>
      <p class="muted small"><%= t('teacher.forSubject') %> <%= subject_label %> · <span class="chip chip-school"><%= gradeLabel(lesson.school_level || 'cp') %></span> · <%= t('common.level') %> <%= lesson.level %> · <%= t('common.score') %> ≥ <%= lesson.target_score %>%</p>
      <h1><%= lesson.title %></h1>
    </div>
    <div>
      <a class="btn btn-ghost" href="/teacher"><%= t('teacher.viewLessons') %></a>
      <a class="btn btn-ghost" href="/teacher/lessons/<%= lesson.id %>/edit"><%= t('common.edit') %></a>
    </div>
  </div>

  <div class="card">
    <details>
      <summary><%= t('teacher.lessonContentPreview') %></summary>
      <p class="prewrap"><%= lesson.raw_lesson_text %></p>
    </details>
  </div>

  <div class="card">
    <h2><%= t('teacher.generateGames') %></h2>
    <form action="/teacher/lessons/<%= lesson.id %>/generate" method="post">
      <div class="field">
        <label><%= t('teacher.genderTheme') %></label>
        <div class="radio-row">
          <label class="radio"><input type="radio" name="genderTheme" value="neutral" checked> <%= t('teacher.neutral') %></label>
          <label class="radio"><input type="radio" name="genderTheme" value="male"> <%= t('teacher.boys') %></label>
          <label class="radio"><input type="radio" name="genderTheme" value="female"> <%= t('teacher.girls') %></label>
          <label class="radio"><input type="radio" name="genderTheme" value="both"> <%= t('teacher.both') %></label>
        </div>
      </div>

      <div class="row-2">
        <div class="field">
          <label for="difficultyHint"><%= t('common.level') %> <%= t('adaptive.delegate') %></label>
          <select id="difficultyHint" name="difficultyHint">
            <% var maxHintLv = (typeof MAX_LEVEL === 'number') ? MAX_LEVEL : 10; for (var lv = 1; lv <= maxHintLv; lv++) { %>
              <option value="<%= lv %>" <%= (suggested === lv) ? 'selected' : '' %>><%= lv %></option>
            <% } %>
          </select>
          <p class="hint"><%= t('teacher.generateHint') %></p>
        </div>
        <div class="field">
          <label for="template"><%= t('teacher.template') %></label>
          <select id="template" name="template">
            <option value=""><%= t('teacher.templateAuto') %></option>
            <option value="airplane"><%= templateLabel('airplane') %></option>
            <option value="whack_a_mole"><%= templateLabel('whack_a_mole') %></option>
            <option value="flying_fruit"><%= templateLabel('flying_fruit') %></option>
          </select>
        </div>
      </div>
      <div class="row-2">
        <div class="field">
          <label for="extraInstructions"><%= t('teacher.extraInstructions') %></label>
          <input id="extraInstructions" name="extraInstructions" type="text" placeholder="<%= t('teacher.extraInstructionsPlaceholder') %>">
        </div>
      </div>

      <button class="btn btn-primary" type="submit" <%= busy ? 'disabled' : '' %>><%= t('teacher.generateGames') %></button>
      <% if (busy) { %><span class="muted small"><%= t('teacher.generating') %></span><% } %>
    </form>
  </div>

  <div class="card">
    <h2><%= t('teacher.tripleHeading') %></h2>
    <p class="hint"><%= t('teacher.tripleSub') %></p>
    <form action="/teacher/lessons/<%= lesson.id %>/generate-triple" method="post">
      <div class="row-2">
        <div class="field">
          <label for="triple-variant"><%= t('teacher.profile') %></label>
          <select id="triple-variant" name="variant">
            <% VARIANTS.forEach(function(v) { %>
              <option value="<%= v %>"><%= profileLabel(v) %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="triple-genderTheme"><%= t('teacher.genderTheme') %></label>
          <select id="triple-genderTheme" name="genderTheme">
            <option value="neutral"><%= t('teacher.neutral') %></option>
            <option value="male"><%= t('teacher.boys') %></option>
            <option value="female"><%= t('teacher.girls') %></option>
          </select>
        </div>
      </div>
      <div class="field">
        <label for="triple-extraInstructions"><%= t('teacher.extraInstructions') %></label>
        <input id="triple-extraInstructions" name="extraInstructions" type="text" placeholder="<%= t('teacher.extraInstructionsPlaceholder') %>">
      </div>
      <button class="btn btn-primary" type="submit" <%= busy ? 'disabled' : '' %>><%= t('teacher.tripleGenerate') %></button>
    </form>
  </div>

  <% if (jobs.length) { %>
    <div class="card">
      <h2><%= t('teacher.aiMode') %></h2>
      <ul class="job-list">
        <% jobs.slice(0,5).forEach(function(j){ %>
          <li>
            <span class="chip chip-<%= j.status %>"><%= j.status %></span>
            <%= j.payload ? t({neutral:'teacher.neutral',male:'teacher.boys',female:'teacher.girls'}[JSON.parse(j.payload).genderTheme] || 'teacher.neutral') : '' %>
            <span class="small muted"><%= t({pending:'teacher.statusPending',running:'teacher.generating',done:'gen.done',failed:'teacher.generationFailed'}[j.status] || '') %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <div class="card">
    <h2><%= t('teacher.gamesTitle') %></h2>
    <% if (!games.length) { %>
      <p class="muted"><%= t('teacher.noGames') %></p>
    <% } %>
    <% games.forEach(function(g){ %>
      <div class="game-row">
        <div class="game-row-meta">
          <strong><%= profileLabel(g.variant) %></strong>
          ·
          <%= t({male:'teacher.boys',female:'teacher.girls',neutral:'teacher.neutral'}[g.gender_theme]) %>
          <span class="chip chip-template"><%= templateLabel(g.template_type) %></span>
          <span class="chip chip-<%= g.status %>"><%= t({draft:'teacher.statusDraft',pending_review:'teacher.statusPending',approved:'teacher.statusApproved',rejected:'teacher.statusRejected'}[g.status]) %></span>
          <% if (g.notes) { %><span class="small muted">(<%= g.notes %>)</span><% } %>
        </div>
        <div class="game-row-actions">
          <% if (g.status === 'pending_review') { %>
            <a class="btn btn-primary btn-sm" href="/teacher/games/<%= g.id %>/preview"><%= t('teacher.previewApprove') %></a>
            <form action="/teacher/games/<%= g.id %>/approve" method="post">
              <button class="btn btn-success btn-sm" type="submit"><%= t('teacher.approvePublish') %></button>
            </form>
            <form action="/teacher/games/<%= g.id %>/reject" method="post">
              <button class="btn btn-danger btn-sm" type="submit"><%= t('teacher.reject') %></button>
            </form>
          <% } else { %>
            <a class="btn btn-ghost btn-sm" href="/teacher/games/<%= g.id %>/preview"><%= t('teacher.preview') %></a>
            <% if (g.status === 'rejected') { %>
              <form action="/teacher/games/<%= g.id %>/approve" method="post">
                <button class="btn btn-success btn-sm" type="submit"><%= t('teacher.approvePublish') %></button>
              </form>
            <% } %>
          <% } %>
        </div>
      </div>
    <% }); %>
  </div>
</main>
<%- include('../partials/foot') %>