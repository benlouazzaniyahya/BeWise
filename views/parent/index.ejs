<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="wrap page">
  <div class="page-head">
    <h1><%= t('parent.welcome') %></h1>
    <a class="btn btn-primary" href="/parent/children/new"><%= t('parent.addChild') %></a>
  </div>

  <% if (!children.length) { %>
    <div class="card empty">
      <p><%= t('parent.noChildren') %></p>
      <p class="hint"><%= t('parent.noChildrenHint') %></p>
    </div>
  <% } %>

  <div class="lesson-grid">
    <% children.forEach(function(c){ %>
      <div class="card lesson-card">
        <div class="lesson-card-head">
          <span class="chip chip-green"><%= t(c.gender === 'male' ? 'parent.male' : 'parent.female') %> · <%= c.age %></span>
          <span class="chip chip-subject"><%= t(c.profile_type === 'special_needs' ? 'parent.profileSpecial' : 'parent.profileStandard') %></span>
        </div>
        <h3><%= c.display_name %></h3>
        <div class="progress">
          <div class="progress-bar" style="width:<%= c.pct %>%"></div>
        </div>
        <p class="small muted"><%= c.passed %>/<%= c.total %> <%= t('admin.lessons') %> · <%= c.pct %>%</p>
        <div class="row-buttons">
          <a class="btn btn-primary btn-sm" href="/parent/children/<%= c.id %>"><%= t('parent.openDashboard') %></a>
          <a class="btn btn-ghost btn-sm" href="/parent/children/<%= c.id %>/edit"><%= t('common.edit') %></a>
        </div>
      </div>
    <% }); %>
  </div>
</main>
<%- include('../partials/foot') %>