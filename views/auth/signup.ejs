<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<main class="wrap page">
  <div class="card auth-card">
    <h1><%= t('auth.signupTitle') %></h1>
    <p class="muted"><%= t('auth.signupSub') %></p>

    <form action="/signup" method="post">
      <div class="field">
        <label for="email"><%= t('common.email') %></label>
        <input id="email" name="email" type="email" required autofocus>
      </div>
      <div class="field">
        <label for="password"><%= t('common.password') %></label>
        <input id="password" name="password" type="password" required minlength="6">
      </div>
      <button class="btn btn-primary btn-block" type="submit"><%= t('nav.signup') %></button>
    </form>

    <% if (googleEnabled) { %>
      <div class="divider"><%= t('auth.or') %></div>
      <a class="btn btn-google btn-block" href="/auth/google"><%= t('auth.google') %></a>
    <% } %>

    <p class="center"><a href="/login"><%= t('auth.haveAccount') %></a></p>
  </div>
</main>
<%- include('../partials/foot') %>