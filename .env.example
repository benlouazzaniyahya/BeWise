# --- Server ---
PORT=3000
BASE_URL=http://localhost:3000

# Secrets - change these in production
JWT_SECRET=change-me-nabta-jwt-secret
COOKIE_SECRET=change-me-nabta-cookie-secret

# --- LLM (OpenRouter) ---
# If OPENROUTER_API_KEY is not set, the app runs in "offline demo mode"
# and uses a built-in template generator so you can still demo the flow.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
# Optional - OpenRouter attribution (your site)
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=nabta

# --- Google OAuth (only needed for the "Sign in with Google" button) ---
# See https://console.cloud.google.com/apis/credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI must be:  <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=